# Database
DATABASE_URL="postgresql://user:password@localhost:5432/meuportal?schema=public"

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="team_logos"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin (painel /admin)
ADMIN_EMAIL="admin@example.com"
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 12))"
# IMPORTANTE: o Next.js expande "$" como referência a outra variável dentro do .env,
# então troque cada "$" do hash gerado por "\$" antes de colar aqui.
ADMIN_PASSWORD_HASH="bcrypt-hash-here"

# Cron (Vercel injeta este valor automaticamente no header Authorization das execuções agendadas)
CRON_SECRET="gere-com-node-crypto-randomBytes" 